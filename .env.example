# ===== LLM 接口配置 =====
# 必填：OpenAI 兼容接口的 API Key
LLM_API_KEY=sk-your-api-key
# 可选：兼容 OpenAI 协议的网关地址，留空使用官方地址
LLM_BASE_URL=https://api.openai.com/v1
# 文本模型：用于需求解构、测试点设计、用例生成与评审
TEXT_MODEL=gpt-4o-mini
# 视觉模型：用于 PRD 中流程图/状态图/UI 原型图的细节提取
VISION_MODEL=gpt-4o

# ===== 可选运行参数 =====
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
OUTPUT_DIR=outputs
